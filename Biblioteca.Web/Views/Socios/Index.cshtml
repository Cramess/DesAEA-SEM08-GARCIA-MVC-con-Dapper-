@model IEnumerable<Biblioteca.Web.Models.Socio>
@{
    ViewData["Title"] = "Socios";
}
<div class="page-header">
    <h1>Socios</h1>
    <a asp-action="Create" class="btn btn-primary" id="btn-nuevo-socio">Nuevo Socio</a>
</div>
@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <p class="mt-2">No hay socios registrados.</p>
    </div>
}
else
{
    <div class="table-wrapper">
        <table class="table table-hover" id="tabla-socios">
            <thead>
                <tr>
                    <th>#</th>
                    <th>DNI</th>
                    <th>Nombre</th>
                    <th>Correo</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var socio in Model)
                {
                    <tr id="socio-@socio.SocioId">
                        <td>@socio.SocioId</td>
                        <td><code>@socio.DNI</code></td>
                        <td class="fw-semibold">@socio.Nombre</td>
                        <td>
                            @if (!string.IsNullOrEmpty(socio.Email))
                            {
                                <a href="mailto:@socio.Email" style="color: var(--color-accent)">@socio.Email</a>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (socio.Activo)
                            {
                                <span class="badge-estado badge-devuelto">Activo</span>
                            }
                            else
                            {
                                <span class="badge-estado badge-atrasado">Inactivo</span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
